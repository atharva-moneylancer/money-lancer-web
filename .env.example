# ── Required ──────────────────────────────────────────────────────────────────

# AdvisorKhoj — mutual fund data (schemes, NAV, performance, SIF)
ADVISORKHOJ_API_KEY=
ADVISORKHOJ_BASE_URL=https://mfapi.advisorkhoj.com
ADVISORKHOJ_MFBOX_URL=https://advisorkhoj.themfbox.com/advisory-tools

# ── Optional ──────────────────────────────────────────────────────────────────

# Market ticker (NIFTY, SENSEX, GOLD, USD/INR)
# Free key at https://twelvedata.com — 800 credits/day, no card needed.
# Leave blank to use Yahoo Finance fallback (no key required).
TWELVE_DATA_API_KEY=

# Financial news feed — https://newsapi.org (100 req/day free tier)
NEWS_API_KEY=

# YouTube videos section
# Use channel ID (UCxxxxxx) or handle (@MoneyLancer) — RSS used by default.
# Set YOUTUBE_API_KEY for richer metadata (view counts, durations).
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=
YOUTUBE_API_KEY=
